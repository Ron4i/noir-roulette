# ─── Сеть ────────────────────────────────────────────────────────────────
# Порт HTTP+WebSocket сервера
PORT=3001
# Интерфейс прослушивания (0.0.0.0 — доступ из локальной сети)
HOST=0.0.0.0
NODE_ENV=development

# ─── WebRTC ──────────────────────────────────────────────────────────────
# ICE-серверы в формате JSON-массива. По умолчанию — публичные STUN.
# Для продакшена добавьте TURN, иначе P2P не соберётся у части клиентов:
#   ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":"turn:host:3478","username":"u","credential":"p"}]
ICE_SERVERS=

# ─── Таймауты и лимиты сессии ────────────────────────────────────────────
# Сколько живёт сессия без входящей активности (мс)
IDLE_TIMEOUT_MS=600000
# Как часто пинговать сокеты, чтобы в очереди не копились «призраки» (мс)
HEARTBEAT_MS=30000
# Предупредить, если у собеседника за это время не появился ни один медиатрек
MEDIA_TIMEOUT_MS=12000

# ─── Чат ─────────────────────────────────────────────────────────────────
# Жёсткий серверный лимит символов в одном сообщении
MAX_MESSAGE_CHARS=500
# Сколько сообщений разрешено в окне CHAT_RATE_WINDOW_MS
CHAT_RATE_LIMIT=14
CHAT_RATE_WINDOW_MS=10000

# ─── Подбор ──────────────────────────────────────────────────────────────
# Максимум тем, которые можно выбрать для одного входа в очередь
INTEREST_PICKS_PER_JOIN=3
# Сколько случайных людей предлагать в «случайной» очереди
RANDOM_SUGGESTIONS=3

# ─── Модерация ───────────────────────────────────────────────────────────
# Сколько жалоб до временного бана
BAN_THRESHOLD=3
# Длительность бана после достижения порога (мс)
BAN_DURATION_MS=1800000
# Тишина в чате дольше этого (мс) — повод пометить разговор как подозрительный
INACTIVITY_WARN_MS=25000

# ─── Комнаты ─────────────────────────────────────────────────────────────
# Максимум гостей в одной комнате
MAX_ROOM_GUESTS=8
# Сколько последних матчей и сообщений помнит сервер в рамках сессии
MAX_RETAINED_EVENTS=200

# ─── Политика допуска ────────────────────────────────────────────────────
# open  — любой посетитель
# adult — только 18+ (самодекларация, НЕ проверка личности)
ACCESS_MODE=open
