{
  "name": "noir-roulette",
  "version": "0.2.0-beta.1",
  "private": true,
  "description": "Noir Roulette — анонимный видео-чат со случайным собеседником: подбор по интересам, комнаты, статистика (WebRTC, beta)",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run build",
    "check:protocol": "node scripts/check-protocol.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "vite": "^7.1.7"
  }
}
